# HCTX Construction Intel — Environment Variables
# Copy to .env and fill in. Never commit .env to git.

# ─── Optional: GHL webhook for direct lead sync (skip if using CSV) ──
GHL_WEBHOOK_URL=
GHL_API_KEY=

# ─── Optional: Twilio for SMS daily digest ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHILLIP_PHONE=+1XXXXXXXXXX

# ─── Optional: Mapbox for dashboard (free token at mapbox.com) ──────
# Note: This is also stored in browser localStorage; this var is for server-side usage only.
MAPBOX_TOKEN=

# ─── Scraping behavior overrides ────────────────────────────────────
SCRAPE_LOOKBACK_DAYS=7
RATE_LIMIT_SECONDS=3.0
